// Limite excedido en una vuelta de un repeat: el mensaje dice el valor
// del indice en esa vuelta.
// Esperado: error en la linea 15: Y = 250 esta fuera de los limites de la maquina (con fila = 4)

machine Ender3 {
    limite_x: 220;
    limite_y: 220;
    limite_z: 250;
    feedrate_max: 3000;
}

main {
    AutoHome();
    repeat 5 as fila {
        Move(X: 10, Y: 10 + fila * 60);
    }
}
