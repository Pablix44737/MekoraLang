// La variable crece en cada vuelta y se pasa de limite_x en las dos
// ultimas. El error sale una sola vez, con el valor del indice.
// Esperado: error en la linea 17: X = 250 esta fuera de los limites

machine Ender3 {
    limite_x: 220;
    limite_y: 220;
    limite_z: 250;
    feedrate_max: 3000;
}

main {
    var x : number = 100;
    AutoHome();
    repeat 5 as vuelta {
        x = x + 50;
        Move(X: x);
    }
}
