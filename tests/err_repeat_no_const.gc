// repeat con una variable como cantidad.
// Esperado: error en la linea 13: la cantidad de repeticiones tiene que ser constante, y 'vel' es una variable

machine Ender3 {
    limite_x: 220;
    limite_y: 220;
    limite_z: 250;
    feedrate_max: 3000;
}

main {
    var vel : number = 3;
    repeat vel {
        Wait(1);
    }
}
