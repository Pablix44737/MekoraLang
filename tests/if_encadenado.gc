// if / else if / else encadenado.
// Esperado: compila sin errores

machine Ender3 {
    limite_x: 220;
    limite_y: 220;
    limite_z: 250;
    feedrate_max: 3000;
}

const TEMP : number = 200;

main {
    if (TEMP > 250) {
        Message("Demasiado caliente");
    } else if (TEMP > 180 and TEMP <= 250) {
        SetExtruderTemp(TEMP);
    } else {
        Message("Temperatura baja");
    }
}
