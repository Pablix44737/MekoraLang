// DisableMotors seguido de AutoHome y movimiento: despues de volver a
// referenciar, la posicion es conocida otra vez.
// Esperado: compila sin errores

machine Ender3 {
    limite_x: 220;
    limite_y: 220;
    limite_z: 250;
    feedrate_max: 3000;
}

main {
    AutoHome();
    Move(X: 100, Y: 100, Z: 10);
    DisableMotors();
    Message("Mover a mano");
    AutoHome();
    Move(X: 50, Y: 50);
}
