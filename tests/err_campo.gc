// Campo que la maquina no tiene, leido a traves de un parametro.
// Esperado: error en la linea 12: la maquina 'Ender3' no tiene el campo 'campo_inexistente'

machine Ender3 {
    limite_x: 220;
    limite_y: 220;
    limite_z: 250;
    feedrate_max: 3000;
}

procedure Preparar(m: machine) {
    SetBedTemp(m.campo_inexistente);
}

main {
    Preparar(Ender3);
}
