// Limite excedido por el argumento de una llamada.
// Esperado: error en la linea 12: X = 300 esta fuera de los limites de la maquina (nota en la linea 17)

machine Ender3 {
    limite_x: 220;
    limite_y: 220;
    limite_z: 250;
    feedrate_max: 3000;
}

procedure Ir(x: number) {
    Move(X: x);
}

main {
    AutoHome();
    Ir(300);
}
