// repeat cuya cantidad es un parametro que, en la llamada, recibe una
// variable. Lo detecta el segundo recorrido, con la nota de la llamada.
// Esperado: error en la linea 13: la cantidad de repeticiones tiene que ser constante, y depende del parametro 'n'

machine Ender3 {
    limite_x: 220;
    limite_y: 220;
    limite_z: 250;
    feedrate_max: 3000;
}

procedure Purgar(n: number) {
    repeat n {
        Extrude(E: 10, F: 300);
    }
}

main {
    var k : number = 3;
    Purgar(k);
}
