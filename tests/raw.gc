// Raw emite la linea tal cual. A diferencia de Message, puede tener ';'
// porque quien la escribe esta escribiendo G-code.
// Esperado: compila sin errores

machine Ender3 {
    limite_x: 220;
    limite_y: 220;
    limite_z: 250;
    feedrate_max: 3000;
}

main {
    Raw("M119");
    Raw("M503 ; reporte de configuracion");
}
