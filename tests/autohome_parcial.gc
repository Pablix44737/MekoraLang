// AutoHome(X, Y) deja conocidos solo X e Y: se puede mover en esos dos
// ejes sin tocar Z.
// Esperado: compila sin errores

machine Ender3 {
    limite_x: 220;
    limite_y: 220;
    limite_z: 250;
    feedrate_max: 3000;
}

main {
    AutoHome(X, Y);
    Move(X: 100, Y: 100);
    Draw(X: 120, Y: 100, E: 0.66);
}
