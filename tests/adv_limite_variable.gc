// Un limite que depende de una variable no se puede verificar en
// compilacion: es advertencia, no error. Aunque el repeat recorre el
// cuerpo tres veces, la advertencia sale una sola vez.
// Esperado: compila sin errores, con una advertencia en la linea 17

machine Ender3 {
    limite_x: 220;
    limite_y: 220;
    limite_z: 250;
    feedrate_max: 3000;
}

main {
    var x : number = 50;
    AutoHome();
    repeat 3 {
        Move(X: x);
    }
}
