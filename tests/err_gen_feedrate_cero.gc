// F depende de una variable que termina valiendo 0.
// Esperado: error en la linea 14: F tiene que ser mayor que 0

machine Ender3 {
    limite_x: 220;
    limite_y: 220;
    limite_z: 250;
    feedrate_max: 3000;
}

main {
    var vel : number = 100;
    vel = vel - 100;
    Extrude(E: 5, F: vel);
}
