// Posicion desconocida dentro de un procedimiento: el mensaje dice desde
// que llamada se llego.
// Esperado: error en la linea 17: 'Move' con posicion desconocida en los ejes X, Y (nota en la linea 23)

machine Ender3 {
    limite_x: 220;
    limite_y: 220;
    limite_z: 250;
    feedrate_max: 3000;
}

procedure Liberar() {
    DisableMotors();
}

procedure Barrido() {
    Move(X: 10, Y: 10);
}

main {
    AutoHome();
    Liberar();
    Barrido();
}
